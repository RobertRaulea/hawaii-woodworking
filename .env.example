# Copy to .env.local for local TEST development.
# See docs/environments.md. Never put backend secrets in VITE_* variables.
VITE_APP_ENV=test
VITE_SITE_URL=https://hawaii-woodworking-test.vercel.app
CONVEX_DEPLOYMENT=dev:exuberant-fox-228

# Convex Configuration (Required)
# Test only. Do not temporarily point this file at production for seeding.
VITE_CONVEX_URL=https://exuberant-fox-228.convex.cloud

# Clerk Configuration (customer and staff authentication)
# Get your publishable key from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# --- Convex Dashboard Environment Variables ---
# These are BACKEND settings, not frontend hosting credentials.
# APP_ENV=test
# SITE_URL=https://hawaii-woodworking-test.vercel.app
# CHECKOUT_ENABLED=true
# CLERK_JWT_ISSUER_DOMAIN=https://choice-fowl-16.clerk.accounts.dev
# STRIPE_SECRET_KEY=sk_test_your_sandbox_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Email & Invoice Automation (Required for order notifications) ---
# Resend API Key - Get from: https://resend.com/api-keys
# Disabled automatically in TEST. Configure only in the production backend.
# RESEND_API_KEY=re_your_resend_api_key

# Admin notification email address
# ADMIN_EMAIL=your_admin_email

# Verified sender email (must be verified in Resend dashboard)
# RESEND_FROM_EMAIL=orders@hawaiiproducts.ro

# Oblio API Credentials - Get from: Oblio Settings → API
# OBLIO_API_EMAIL=your_api_email@example.com
# OBLIO_API_SECRET=your_api_secret_token
# OBLIO_API_CIF=your_company_cif
