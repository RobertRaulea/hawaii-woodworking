{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "VITE_APP_ENV=test vite build --mode test",
    "build:production": "VITE_APP_ENV=production vite build --mode production",
    "check:env": "node --experimental-strip-types scripts/checkEnvironment.ts",
    "test:configure": "node --experimental-strip-types scripts/configureTest.ts",
    "test:sync": "node --experimental-strip-types scripts/syncTest.ts",
    "test:publish": "node --experimental-strip-types scripts/publishTest.ts",
    "test:seed": "convex run --deployment-name exuberant-fox-228 demoCatalog:seed '{}'",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-test-module-mocks --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:ui": "node --experimental-test-module-mocks --import ./tests/register.mjs --import ./tests/ui/setup.mjs --test tests/ui/*.test.tsx",
    "preview": "vite preview",
    "postinstall": "echo 'Remember to create a .env file with Convex credentials'",
    "stripe:seed": "ts-node --esm scripts/seedStripe.ts",
    "convex:seed": "ts-node --esm scripts/seedConvex.ts",
    "convex:migrate": "ts-node --esm scripts/migrateSupabaseToConvex.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@stripe/stripe-js": "^10.2.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "^1.49.0",
    "embla-carousel-react": "8.6.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.66.0",
    "posthog-js": "1.444.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.11",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "resend": "^6.37.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "26.1.0",
    "postcss": "^8.4.35",
    "stripe": "^18.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
